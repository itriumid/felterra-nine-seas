extends SceneTree
## Regenerates simulation/polar_table.gd, the speed polars the world map sails by. Run it after
## any change to the sailing model; a test fails while the table is out of date.
## Run with: godot --headless --path . --script tools/build_polars.gd

const WIND_SPEEDS: Array[float] = [2.0, 4.0, 6.0, 8.0, 11.0, 15.0]
## Cargo as a fraction of each ship's capacity: empty, half and full.
const LOADS: Array[float] = [0.0, 0.5, 1.0]
const ANGLE_STEP := 10.0
const OUTPUT := "res://simulation/polar_table.gd"


func _init() -> void:
	var lines: Array[String] = [
		"class_name PolarTable",
		"extends RefCounted",
		"## Steady speeds in meters per second, by ship, load, true wind speed (rows) and angle off the",
		"## wind (columns, every %d degrees from 0 to 180)." % int(ANGLE_STEP),
		"##",
		"## Generated by tools/build_polars.gd from the sailing model. Don't edit it; rebuild it.",
		"",
		"const LOADS: Array[float] = %s" % str(LOADS),
		"const WIND_SPEEDS: Array[float] = %s" % str(WIND_SPEEDS),
		"const ANGLE_STEP := %.1f" % ANGLE_STEP,
		"const ANGLE_COUNT := %d" % (int(180.0 / ANGLE_STEP) + 1),
		"const SPEEDS := {",
	]
	for design in ShipDesign.all():
		lines.append('\t"%s": [' % design.id)
		for load in LOADS:
			lines.append("\t\t[")
			for wind_speed in WIND_SPEEDS:
				var row: Array[String] = []
				var angle := 0.0
				while angle <= 180.0:
					row.append("%.3f" % Polar.steady_speed(design, angle, wind_speed, 200.0, load))
					angle += ANGLE_STEP
				lines.append("\t\t\t[%s]," % ", ".join(row))
			lines.append("\t\t],")
		lines.append("\t],")
	lines.append("}")
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("Wrote %s" % OUTPUT)
	quit()
