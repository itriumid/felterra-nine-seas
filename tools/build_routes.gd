extends SceneTree
## Regenerates simulation/route_table.gd: the route between every pair of ports, so ships never
## plan a voyage in the middle of a frame. Run it after changing the chart, the ports or the
## navigation; a test fails while the table is out of date.
## Run with: godot --headless --path . --script tools/build_routes.gd

const OUTPUT := "res://simulation/route_table.gd"


func _init() -> void:
	var chart := Chart.new()
	var navigation := Navigation.new(chart)
	var ports := Ports.on(chart)
	var lines: Array[String] = [
		"class_name RouteTable",
		"extends RefCounted",
		"## Routes between every pair of ports, as waypoints in meters, keyed by Navigation.key.",
		"##",
		"## Generated by tools/build_routes.gd from the chart, the ports and the navigation. Don't",
		"## edit it; rebuild it.",
		"",
		"const ROUTES := {",
	]
	for from in ports:
		for to in ports:
			if from == to:
				continue
			var points: Array[String] = []
			for point in navigation.search(from.position, to.position):
				points.append("Vector2(%.1f, %.1f)" % [point.x, point.y])
			lines.append('\t"%s": [%s],' % [Navigation.key(from.position, to.position), ", ".join(points)])
	lines.append("}")
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("Wrote %s" % OUTPUT)
	quit()
